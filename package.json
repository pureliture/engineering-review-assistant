{
  "name": "engineering-review-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data-only ChatGPT MCP app for evidence-backed engineering review of allowlisted repository changes.",
  "scripts": {
    "build": "npm run build:server && npm run build:widget",
    "build:server": "tsc -p tsconfig.json",
    "build:widget": "tsc -p tsconfig.widget.json && vite build",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "widget:dev": "vite --host 127.0.0.1",
    "inspect": "npx @modelcontextprotocol/inspector http://127.0.0.1:2091/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "express": "^4.19.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=20"
  }
}
